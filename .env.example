# Copy this file to .env (gitignored) and fill it in yourself. Claude Code must never read or print .env.

# Track B (optional). Set a spend cap in each provider's dashboard first.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local models (optional, Ollama on your PC)
OLLAMA_BASE_URL=http://localhost:11434

# Mock LLM used by auto-chat targets
MOCK_LLM_HOST=127.0.0.1
MOCK_LLM_PORT=11435
MOCK_CHUNK=3
MOCK_DELAY_MS=30
