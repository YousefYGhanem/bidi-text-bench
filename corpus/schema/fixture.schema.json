{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/YousefYGhanem/bidi-text-bench/corpus/schema/fixture.schema.json",
  "title": "bidi-text-bench fixture (docs/FIXTURE_SPEC.md §4, taxonomy v1 per ADR-0003)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lang",
    "category",
    "title",
    "text",
    "markdown",
    "base_direction",
    "isolate_spans",
    "author_spans",
    "surfaces",
    "severity",
    "expected_notes",
    "status",
    "verification",
    "source",
    "related_issues"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(ar|he)-[a-z]+-[0-9]{3}$" },
    "lang": { "enum": ["ar", "he"] },
    "category": {
      "enum": [
        "BD",
        "AL",
        "ISO",
        "NP",
        "NUM",
        "CODE",
        "LIST",
        "TBL",
        "FONT",
        "TRUNC",
        "MIR",
        "COPY"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "markdown": { "type": "boolean" },
    "base_direction": { "enum": ["rtl", "ltr"] },
    "isolate_spans": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "author_spans": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["message", "input", "stream", "title"] }
    },
    "severity": { "enum": ["blocker", "major", "minor"] },
    "expected_notes": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified", "rejected"] },
    "verification": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "at", "hash"],
          "properties": {
            "by": { "type": "string", "minLength": 1 },
            "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
            "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "source": { "type": "string", "pattern": "^(original|adapted:https?://\\S+)$" },
    "related_issues": {
      "type": "array",
      "items": { "type": "string", "pattern": "^https?://\\S+$" }
    }
  }
}
